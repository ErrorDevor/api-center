# Set to "true" to enable the onboarding-completed cookie (required for
# local dev — without it /home always redirects back to /start).
NEXT_PUBLIC_ONBOARDING_COOKIE_ENABLED=true

# Where the providers/prices feed is fetched from (see toSidebarProviders /
# toModelItems consumers). Defaults to the co-located static file at
# /data/providers.json (public/data/providers.json) when unset — matches
# bestai_price_parser_tz.md's FRONTEND_JSON_PATH for a parser running on the
# same host as this site.
#
# Point this at a remote URL instead if the parser runs elsewhere, e.g.:
# NEXT_PUBLIC_PROVIDERS_JSON_URL=https://parser.example.com/data/providers.json
#
# A remote host must send CORS headers allowing this site's origin, or the
# browser will block the fetch.
# NEXT_PUBLIC_PROVIDERS_JSON_URL=
