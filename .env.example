# Set to "true" to enable the onboarding-completed cookie (required for
# local dev — without it /home always redirects back to /start).
NEXT_PUBLIC_ONBOARDING_COOKIE_ENABLED=true

# Where the providers/prices feed is fetched from (see toSidebarProviders /
# toModelItems consumers). When unset, defaults to the co-located static
# file at /data/providers.json — that's the production path: the backend
# parser writes real data straight onto the server's disk at
# public/data/providers.json, outside of git, so production needs no
# config here.
#
# Or point it at any other remote URL (e.g. a parser backend on a
# different domain/VPS) — that host must send CORS headers allowing this
# site's origin, or the browser will block the fetch:
NEXT_PUBLIC_PROVIDERS_JSON_URL=https://jigji.com/data/providers.json
