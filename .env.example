# Set to "true" to enable the onboarding-completed cookie (required for
# local dev — without it /home always redirects back to /start).
NEXT_PUBLIC_ONBOARDING_COOKIE_ENABLED=true

# Where the providers/prices feed is fetched from (see toSidebarProviders /
# toModelItems consumers). When unset, defaults to the co-located static
# file at /data/providers.json — only useful if something writes real data
# straight onto the server's disk at public/data/providers.json (outside
# of git); otherwise the page just renders with an empty feed.
#
# In production, point this at the gateway (sub2api) through nginx's
# same-origin proxy — see nginx/conf.d/default.conf's /gateway/ location —
# so it's a live request, not a stale file:
#   NEXT_PUBLIC_PROVIDERS_JSON_URL=/gateway/api/v1/data/providers.json
#
# For local dev, where that gateway isn't running, point it at a remote
# feed instead (needs CORS headers allowing this site's origin):
NEXT_PUBLIC_PROVIDERS_JSON_URL=https://jigji.com/data/providers.json

# Same idea for the model catalog (display name + localized description
# per canonical_model_id — see useModelCatalog / toModelItems consumers).
# Defaults to the co-located static file at /data/models.json; override the
# same way as NEXT_PUBLIC_PROVIDERS_JSON_URL above.
NEXT_PUBLIC_MODELS_JSON_URL=https://jigji.com/data/models.json

# The /rating leaderboard feeds — one per category tab (LLM, image / video
# generation, text-to-speech, speech-to-text), see the RANKING_CATEGORIES
# consumers. Each defaults to its co-located static file at
# /data/<name>_rankings.json; override the same way as
# NEXT_PUBLIC_PROVIDERS_JSON_URL above.
NEXT_PUBLIC_LLM_RANKINGS_JSON_URL=https://bestaiprice.com/gateway/data/llm_rankings.json
NEXT_PUBLIC_IMAGE_GENERATION_RANKINGS_JSON_URL=https://bestaiprice.com/gateway/data/image_generation_rankings.json
NEXT_PUBLIC_VIDEO_GENERATION_RANKINGS_JSON_URL=https://bestaiprice.com/gateway/data/video_generation_rankings.json
NEXT_PUBLIC_TEXT_TO_SPEECH_RANKINGS_JSON_URL=https://bestaiprice.com/gateway/data/text_to_speech_rankings.json
NEXT_PUBLIC_SPEECH_TO_TEXT_RANKINGS_JSON_URL=https://bestaiprice.com/gateway/data/speech_to_text_rankings.json

# Same idea for the per-vendor "Cheap {vendor} API" header title + blurb
# shown above the models table (see useVendorDescriptions consumers).
# Defaults to the co-located static file at /data/api_descriptions.json;
# override the same way as NEXT_PUBLIC_PROVIDERS_JSON_URL above.
NEXT_PUBLIC_API_DESCRIPTIONS_JSON_URL=https://bestaiprice.com/gateway/data/api_descriptions.json

# Same idea for the per-provider localized description shown on a
# provider's reviews page (see useProviderDescriptions consumers), joined
# with providers.json by provider_domain. Defaults to the co-located static
# file at /data/provider_descriptions.json; override the same way as
# NEXT_PUBLIC_PROVIDERS_JSON_URL above.
NEXT_PUBLIC_PROVIDER_DESCRIPTIONS_JSON_URL=https://bestaiprice.com/gateway/data/provider_descriptions.json

# Base URL for the sub2api authentication/user backend (see
# AUTH_API_GUIDE.md), called only from server-side Next.js Route Handlers
# under src/app/api/auth/* (see shared/lib/auth/sub2api.ts) — the browser
# never talks to this directly, it only calls our own same-origin
# /api/auth/* routes, which hold the session in httpOnly cookies. This
# must NOT be prefixed NEXT_PUBLIC_ — it must never end up in the client
# bundle.
#
# In production this resolves through nginx's same-origin gateway proxy
# (see nginx/conf.d/default.conf's /gateway/ location, forwarding to the
# sub2api gateway on host.docker.internal:8080) — the same public URL also
# works for local dev, so it's set below and doesn't strictly need
# overriding.
AUTH_API_BASE_URL=https://bestaiprice.com/gateway/api/v1
