# Set to "true" to enable the onboarding-completed cookie (required for
# local dev — without it /home always redirects back to /start).
NEXT_PUBLIC_ONBOARDING_COOKIE_ENABLED=true

# Where the providers/prices feed is fetched from (see toSidebarProviders /
# toModelItems consumers). When unset, defaults to the co-located static
# file at /data/providers.json — only useful if something writes real data
# straight onto the server's disk at public/data/providers.json (outside
# of git); otherwise the page just renders with an empty feed.
#
# In production, point this at the gateway (sub2api) through nginx's
# same-origin proxy — see nginx/conf.d/default.conf's /gateway/ location —
# so it's a live request, not a stale file:
#   NEXT_PUBLIC_PROVIDERS_JSON_URL=/gateway/api/v1/data/providers.json
#
# For local dev, where that gateway isn't running, point it at a remote
# feed instead (needs CORS headers allowing this site's origin):
NEXT_PUBLIC_PROVIDERS_JSON_URL=https://jigji.com/data/providers.json

# Same idea for the model catalog (display name + localized description
# per canonical_model_id — see useModelCatalog / toModelItems consumers).
# Defaults to the co-located static file at /data/models.json; override the
# same way as NEXT_PUBLIC_PROVIDERS_JSON_URL above.
NEXT_PUBLIC_MODELS_JSON_URL=https://jigji.com/data/models.json
